---
layout: default
---

{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign pdf_url = page.cv_pdf %}
  {% else %}
    {% assign pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}

  <script>
    window.location.replace({{ pdf_url | jsonify }});
  </script>

  <a href="{{ pdf_url | escape }}">Open CV (PDF)</a>
{% endif %}
