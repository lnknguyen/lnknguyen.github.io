---
layout: default
---

{% if page.cv_pdf %}
  <a
    {% if page.cv_pdf contains '://' %}
      href="{{ page.cv_pdf }}"
    {% else %}
      href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
    {% endif %}
    target="_blank"
    rel="noopener noreferrer"
    class="float-right"
    style="font-size: 2.25rem; line-height: 1;"
    aria-label="Download PDF"
    title="Download PDF"
  >
    <i class="fa-solid fa-file-pdf"></i>
  </a>
{% endif %}